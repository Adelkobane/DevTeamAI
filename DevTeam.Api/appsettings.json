{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7132",
      "http://localhost:5282"
    ]
  },
  "RateLimiting": {
    "Contact": {
      "PermitLimit": 3,
      "WindowSeconds": 60
    },
    "Ai": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Ai": {
    "Provider": "None",
    "MaxOutputTokens": 1000,
    "Temperature": 0.3,
    "TimeoutSeconds": 60,
    "ContextCharBudget": 8000,
    "OpenAI": {
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-4o-mini"
    },
    "Groq": {
      "BaseUrl": "https://api.groq.com/openai/v1",
      "Model": "openai/gpt-oss-120b",
      "ReasoningEffort": "low"
    },
    "AzureOpenAI": {
      "Endpoint": "",
      "Deployment": "",
      "ApiVersion": "2024-10-21"
    }
  },
  "Email": {
    "Provider": "Log",
    "From": "",
    "FromName": "DevTeam Portfolio",
    "To": "",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "Username": ""
    }
  }
}
