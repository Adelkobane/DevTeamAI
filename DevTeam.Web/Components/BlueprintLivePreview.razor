@using System.Text
@using DevTeam.Web.Models
@using DevTeam.Web.Services
@implements IDisposable
@inject AiClient Ai
@inject ContactPrefill Prefill
@inject IJSRuntime JS
@inject IStringLocalizer<Strings> L

@* Flik 3: live-prototyp. AI:ns HTML visas i en sandlådad iframe och kan skrivas om utan att sidan laddas om. *@
<div class="space-y-5">
    @if (string.IsNullOrWhiteSpace(Spec.PreviewHtml))
    {
        <BlueprintPrototype Spec="Spec" />
    }
    else
    {
        <div @ref="_stage" class="preview-stage glow-surface relative overflow-hidden rounded-2xl border border-white/10 bg-zinc-950/70 shadow-xl shadow-black/40">
            <div class="flex items-center gap-3 border-b border-white/10 bg-white/[0.03] px-3 py-2.5 sm:px-4">
                <span class="flex shrink-0 gap-1.5" aria-hidden="true">
                    <span class="h-2.5 w-2.5 rounded-full bg-red-400/80"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-amber-300/80"></span>
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
                </span>
                <span class="min-w-0 flex-1 truncate rounded-md bg-black/30 px-3 py-1 text-center font-mono text-[11px] text-zinc-500">
                    @($"{Slug}.app")
                </span>
                <button type="button" @onclick="ToggleFullscreenAsync" disabled="@_updating" class="btn btn-glass shrink-0 !px-3 !py-1.5 !text-xs">
                    @L["Builder.Preview.Fullscreen"]
                </button>
            </div>

            <div class="relative">
                <iframe @ref="_frame" sandbox="allow-scripts" referrerpolicy="no-referrer"
                        title="@L["Builder.Preview.FrameTitle", Spec.Title]"
                        class="h-[32rem] w-full bg-zinc-950 transition-opacity duration-300 sm:h-[36rem] @(_updating ? "opacity-40" : "opacity-100")"></iframe>
                @if (_updating)
                {
                    <div class="absolute inset-0 flex items-center justify-center" role="status">
                        <p class="flex items-center gap-2 rounded-full border border-white/10 bg-zinc-950/80 px-4 py-2 text-sm text-cyan-100 shadow-lg backdrop-blur-md">
                            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25" />
                                <path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" stroke-linecap="round" class="opacity-75" />
                            </svg>
                            @L["Builder.Preview.Revising"]
                        </p>
                    </div>
                }
            </div>
        </div>

        <form @onsubmit="ReviseFromField" @onsubmit:preventDefault="true" class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 sm:p-5">
            <h4 class="text-base font-semibold text-white">@L["Builder.Preview.ReviseTitle"]</h4>
            <p class="mt-1 text-xs text-zinc-500">@L["Builder.Preview.ReviseNote"]</p>

            <label for="builder-revise" class="mt-4 block text-sm font-medium text-zinc-300">@L["Builder.Preview.ReviseLabel"]</label>
            <textarea id="builder-revise" @bind="_instruction" @bind:event="oninput" @bind:after="ClearNotice" rows="2" maxlength="400"
                      disabled="@_updating" placeholder="@L["Builder.Preview.RevisePlaceholder"]"
                      class="field resize-y text-base sm:text-sm"></textarea>

            <div class="mt-3">
                <p class="group-label">@L["Builder.QuickLabel"]</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var chip in Chips)
                    {
                        <button type="button" @onclick="() => ReviseAsync(L[chip].Value)" disabled="@_updating"
                                class="chip accent-cyan disabled:cursor-not-allowed disabled:opacity-50">
                            @L[chip]
                        </button>
                    }
                </div>
            </div>

            @if (_error is not null)
            {
                <div class="mt-4 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-200" role="alert">@_error</div>
            }
            else if (_notice)
            {
                <p class="mt-4 text-sm text-emerald-300" role="status">@L["Builder.Preview.Updated"]</p>
            }

            <button type="submit" disabled="@(_updating || InstructionTooShort)" class="btn btn-glass mt-4">
                @if (_updating)
                {
                    <span>@L["Builder.Preview.Revising"]</span>
                }
                else
                {
                    <SparkleIcon CssClass="h-4 w-4" />
                    <span>@L["Builder.Preview.ReviseSend"]</span>
                }
            </button>
        </form>

        <button type="button" @onclick="DownloadAsync" class="btn btn-glass w-full">
            <span aria-hidden="true">📥</span> @L["Builder.Preview.Download"]
        </button>
    }

    <button type="button" @onclick="DeployAsync" class="btn btn-gradient w-full">
        <span aria-hidden="true">🚀</span> @L["Builder.Preview.Deploy"]
    </button>
</div>

@code {
    private const int MinInstructionLength = 3;

    private static readonly string[] Chips =
    [
        "Builder.Preview.Chip.Dark",
        "Builder.Preview.Chip.Hours",
        "Builder.Preview.Chip.Luxury"
    ];

    [Parameter, EditorRequired] public AppSpec Spec { get; set; } = new();

    /// <summary>Idén som blueprinten genererades från.</summary>
    [Parameter] public string Idea { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> OnPreviewUpdated { get; set; }

    private ElementReference _stage;
    private ElementReference _frame;
    private string? _applied;
    private string _instruction = string.Empty;
    private bool _updating;
    private bool _notice;
    private string? _error;
    private CancellationTokenSource? _cts;

    private static string Language => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private bool InstructionTooShort => _instruction.Trim().Length < MinInstructionLength;

    private string Slug => new string(Spec.Title.Trim().ToLowerInvariant()
        .Select(c => char.IsLetterOrDigit(c) ? c : '-')
        .ToArray()).Trim('-');

    private string FileName => HtmlSyntax.FileName(Spec.Title);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var html = Spec.PreviewHtml;
        if (string.IsNullOrWhiteSpace(html) || html == _applied) return;

        try
        {
            await JS.InvokeVoidAsync("devteam.setSrcdoc", _frame, html);
            _applied = html;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    private void ClearNotice() => _notice = false;

    private Task ReviseFromField() => ReviseAsync(null);

    private async Task ReviseAsync(string? instruction)
    {
        var text = (instruction ?? _instruction).Trim();
        if (instruction is not null) _instruction = instruction;
        if (_updating || text.Length < MinInstructionLength || string.IsNullOrWhiteSpace(Spec.PreviewHtml)) return;

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        _updating = true;
        _error = null;
        _notice = false;

        try
        {
            var html = await Ai.UpdatePreviewAsync(Spec.PreviewHtml, text, Language, token);
            await OnPreviewUpdated.InvokeAsync(html);
            _notice = true;
        }
        catch (AiClientException ex)
        {
            _error = ErrorText(ex);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            _updating = false;
        }
    }

    private async Task DownloadAsync()
    {
        if (string.IsNullOrWhiteSpace(Spec.PreviewHtml)) return;

        try
        {
            await JS.InvokeVoidAsync("devteam.downloadText", FileName, Spec.PreviewHtml);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    private async Task DeployAsync()
    {
        Prefill.Request(ComposeDeployment());

        try
        {
            await JS.InvokeVoidAsync("devteam.scrollToId", "contact-form");
            await Task.Delay(700);
            await JS.InvokeVoidAsync("devteam.focusId", "contact-name");
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException or InvalidOperationException)
        {
        }
    }

    private async Task ToggleFullscreenAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("devteam.toggleFullscreen", _stage);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    private string ComposeDeployment()
    {
        var sb = new StringBuilder();
        sb.AppendLine(L["Builder.Brief.Greeting"]);
        sb.AppendLine();
        sb.AppendLine(L["Builder.Deploy.Intro", Spec.Title, Spec.Tagline]);

        if (!string.IsNullOrWhiteSpace(Idea))
            sb.AppendLine().AppendLine($"{L["Builder.Brief.Idea"]} {Cap(Idea.Trim(), 500)}");

        if (!string.IsNullOrWhiteSpace(Spec.Summary))
            sb.AppendLine().AppendLine($"{L["Builder.Brief.Summary"]} {Cap(Spec.Summary, 700)}");

        if (Spec.UserStories.Count > 0)
        {
            sb.AppendLine().AppendLine(L["Builder.Brief.Features"]);
            foreach (var story in Spec.UserStories.Take(5)) sb.AppendLine($"- {Cap(story, 200)}");
        }

        sb.AppendLine();
        if (Spec.TechStack.Count > 0) sb.AppendLine($"{L["Builder.Brief.Tech"]} {string.Join(", ", Spec.TechStack)}");
        if (Spec.Entities.Count > 0) sb.AppendLine($"{L["Builder.Brief.Data"]} {string.Join(", ", Spec.Entities.Select(e => e.Name))}");
        if (Spec.UiComponents.Count > 0) sb.AppendLine($"{L["Builder.Brief.Screens"]} {string.Join(", ", Spec.UiComponents.Select(s => s.Name))}");
        if (Spec.EstimatedTimeline.Count > 0)
            sb.AppendLine(L["Builder.Brief.Timeline", Spec.EstimatedTimeline.Count, Spec.TotalWeeks].Value);

        var header = sb.ToString().TrimEnd();
        var footer = L["Builder.Brief.Footer"].Value;
        var codeLabel = L["Builder.Deploy.Code"].Value;
        var html = Spec.PreviewHtml ?? string.Empty;

        var budget = ContactMessage.MaxMessageLength - header.Length - codeLabel.Length - footer.Length - 6;
        if (budget < 80)
            return Cap(header + "\n\n" + footer, ContactMessage.MaxMessageLength);

        if (html.Length > budget)
            html = html[..(budget - 1)].TrimEnd() + "…";

        return $"{header}\n\n{codeLabel}\n{html}\n\n{footer}";
    }

    private static string Cap(string text, int max)
    {
        if (text.Length <= max) return text;
        var cut = text[..(max - 1)];
        var lastSpace = cut.LastIndexOfAny([' ', '\n']);
        return (lastSpace > max / 2 ? cut[..lastSpace] : cut).TrimEnd() + "…";
    }

    private string ErrorText(AiClientException ex) => ex.Kind switch
    {
        AiErrorKind.RateLimited when ex.RetryAfterSeconds is { } seconds => L["Ai.ErrorRate", seconds].Value,
        AiErrorKind.RateLimited => L["Ai.ErrorRateNoTime"].Value,
        AiErrorKind.Unavailable => L["Ai.ErrorUnavailable"].Value,
        AiErrorKind.BadRequest => L["Ai.ErrorBad"].Value,
        AiErrorKind.NotAnIdea => L["Builder.Error.NotAnIdea"].Value,
        AiErrorKind.Network => L["Ai.ErrorNetwork"].Value,
        _ => L["Ai.ErrorGeneric"].Value
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
